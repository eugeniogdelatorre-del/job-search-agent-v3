# Copy to .env.local for local dev (never commit the filled version).
# Production values live in Vercel → Project → Settings → Environment Variables.

# Safe to expose in the browser (RLS enforces access control).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role — server only. Used by /api routes that bypass RLS
# (e.g. /api/cv/upload writes to resumes on behalf of the user).
# NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=eyJ...
